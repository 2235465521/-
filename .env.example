# ZKBZ 本地配置示例：复制本文件为 .env 后按实际环境修改
# 首次启动也会自动从本文件生成 .env

# ---------- 服务 ----------
HOST=0.0.0.0
PORT=5000
OPEN_BROWSER=true

# ---------- 登录鉴权 ----------
# SECRET_KEY=请改为随机长字符串（不填则自动生成到 data/.flask_secret）
ALLOW_REGISTER=true
SESSION_DAYS=7

# ---------- MySQL（必需）----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=STSC_standard_database

# 可选：mysql 客户端完整路径（找不到时再填）
# MYSQL_EXE=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysql.exe

# Docker Compose 默认账号示例：
# MYSQL_PASSWORD=zkbz

# ---------- PDF 磁盘根目录（下载实体文件时需要）----------
# PDF_ROOT=Z:\磁盘阵列\标准文件下载
# PDF_ROOT=D:\standards\pdf_files
