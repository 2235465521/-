# ZKBZ 本地配置示例：复制本文件为 .env 后按实际环境修改
# 首次启动也会自动从本文件生成 .env

# ---------- 服务 ----------
HOST=0.0.0.0
PORT=5000
OPEN_BROWSER=true

# ---------- MySQL（必需）----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=STSC_standard_database

# 可选：mysql 客户端完整路径（找不到时再填）
# MYSQL_EXE=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysql.exe

# Docker Compose 默认账号示例：
# MYSQL_PASSWORD=zkbz

# ---------- 标准 PDF ----------
# 库内路径多为相对路径（如 国标下载/国标/xxx.pdf），请指向其父目录
# 未配置时会自动探测 Y:/E:/Z: 磁盘阵列，或与项目同级的国标/行标/企标下载目录
# PDF_ROOT=D:\ZKBZ\202607
# PDF_SEARCH_ROOT=

# ---------- 智谱 AI（自然语言检索，开箱即用）----------
# 已内置项目默认 Key；若要改用自己的账号，覆盖下面一行即可
ZHIPU_API_KEY=5f344f0bbfdb478da80e14c8cb8bb74e.NREa621RhRCzEKIl
ZHIPU_MODEL=glm-4-flash
# ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4
